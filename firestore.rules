rules_version = '2';

// Shared Firebase project: web shop dashboard + Flutter builder app.
// Web owns shops / billing / products. Flutter owns estimates, posts, bids,
// notifications, and saved projects. Default-deny at the bottom — every
// collection used by either client must be listed here.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shopIsApproved(shopId) {
      return shopId is string
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.status is string
        && get(/databases/$(database)/documents/shops/$(shopId)).data.status.matches('(?i)^approved$');
    }

    function isApprovedShop() {
      return signedIn() && shopIsApproved(request.auth.uid);
    }

    // The signed-in email passed the emailed OTP and that verification hasn't
    // lapsed (written only by the OTP Cloud Functions; clients can't touch it).
    function emailOtpVerified(email) {
      return exists(/databases/$(database)/documents/otps/$(email))
        && get(/databases/$(database)/documents/otps/$(email)).data.verified == true
        && get(/databases/$(database)/documents/otps/$(email)).data.expires > request.time.toMillis();
    }

    // Field is absent, not a string, or a string within `n` characters.
    function strMax(d, f, n) {
      return !(f in d) || !(d[f] is string) || d[f].size() <= n;
    }

    // Size caps on a shop's free-text fields, so they can't be stuffed with
    // megabytes of junk that every dashboard and the builder app then loads.
    function shopTextOk(d) {
      return strMax(d, "shopName", 120)
        && strMax(d, "ownerName", 120)
        && strMax(d, "phone", 30)
        && strMax(d, "address", 300)
        && strMax(d, "barangay", 120)
        && strMax(d, "description", 2000)
        && strMax(d, "businessHours", 200)
        && strMax(d, "storefrontAbout", 3000);
    }

    // Builder uid on a posted estimate. Canonical field is userId (Auth uid).
    function isPostOwner(data) {
      return signedIn() && (
        data.get('userId', '') == request.auth.uid
        || data.get('builderId', '') == request.auth.uid
        || data.get('ownerId', '') == request.auth.uid
        || data.get('postedBy', '') == request.auth.uid
      );
    }

    function postDoc(postId) {
      return get(/databases/$(database)/documents/projectPosts/$(postId)).data;
    }

    // projectPosts only. A fallback to a separate `projects` collection let any
    // signed-in user create projects/{someone else's postId} and pass this
    // check — i.e. read and accept another builder's quotations.
    function ownsPostedEstimate(postId) {
      return exists(/databases/$(database)/documents/projectPosts/$(postId))
        && isPostOwner(get(/databases/$(database)/documents/projectPosts/$(postId)).data);
    }

    // ── Admins ──────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow write: if isAdmin();
    }

    // ── Shops (web dashboard + builder ranking of approved shops) ───────────
    match /shops/{shopId} {
      allow read: if isOwner(shopId) || isAdmin()
                  || (signedIn() && resource.data.status == "approved");

      // A new application requires that this exact email really passed the
      // emailed OTP (verifyEmailOtp marks otps/{email} verified, server-side
      // only). The OTP gate used to exist only in the browser, so a script
      // could create accounts and flood Shop Applications with fake pending
      // shops without ever verifying an address.
      allow create: if isOwner(shopId)
        && request.resource.data.subscriptionPlan == "basic"
        && request.resource.data.status == "pending"
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email
        && emailOtpVerified(request.auth.token.email)
        && request.resource.data.documents is list
        && request.resource.data.documents.size() <= 12
        && shopTextOk(request.resource.data);

      // Owners may edit ONLY the profile fields the dashboard edits. This was
      // a blocklist, which left everything else writable — including the
      // rating fields (avgRating, ratingCount, …), so a shop could give itself
      // 5★ from 1,000 reviews. Plan, approval, billing, ratings, documents and
      // identity are all written by admins or Cloud Functions (Admin SDK).
      allow update: if isAdmin() || (
        isOwner(shopId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "shopName", "ownerName", "phone", "address", "barangay",
              "description", "notifs", "businessHours", "coverageCities",
              "storefrontAbout", "suppliedCategories", "fcmTokens", "updatedAt",
            ])
        && request.resource.data.get("fcmTokens", []).size() <= 30
        && request.resource.data.get("coverageCities", []).size() <= 50
        && request.resource.data.get("suppliedCategories", []).size() <= 50
        && shopTextOk(request.resource.data)
      ) || (
        isOwner(shopId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt"])
        && request.resource.data.status == "deleted"
      );

      allow delete: if isAdmin();

      match /categories/{categoryId} {
        allow read: if isOwner(shopId) || isAdmin()
                    || get(/databases/$(database)/documents/shops/$(shopId)).data.status == "approved";
        allow write: if (isOwner(shopId) && shopIsApproved(shopId)) || isAdmin();
      }

      match /materials/{materialId} {
        allow read: if isOwner(shopId) || isAdmin()
                    || (signedIn() && shopIsApproved(shopId));
        allow write: if (isOwner(shopId) && shopIsApproved(shopId)) || isAdmin();
      }
    }

    // ── OTPs (email verification) — Cloud Functions / Admin SDK only ────────
    match /otps/{email} {
      allow read, write: if false;
    }

    match /email_otp/{email} {
      allow read, write: if false;
    }

    // PayMongo audit (Admin SDK only)
    match /paymongoActivations/{sessionId} {
      allow read, write: if false;
    }

    match /paymongoEvents/{eventId} {
      allow read, write: if false;
    }

    match /checkoutSessions/{sessionId} {
      allow read, write: if false;
    }

    // ── Subscription payments (manual GCash flow → admin review) ────────────
    // A shop may only create a *pending* request for a known paid plan; it may
    // not pre-set the status or forge the plan. Only admins confirm/reject.
    match /subscriptionPayments/{paymentId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.shopId == request.auth.uid);
      // Created only by the submitPaymentRequest Cloud Function (approved
      // shops, one pending at a time, daily cap, server-set price). A direct
      // client create let ANY account — builders too — spam pending requests
      // with ~1 MB screenshots and a self-reported price.
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── System config (plans, maintenance, etc.) ────────────────────────────
    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /systemLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Products (web shops write; Flutter builders browse) ─────────────────
    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
      allow update: if signedIn()
        && resource.data.shopId == request.auth.uid
        && request.resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
      allow delete: if signedIn()
        && resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
    }

    // Template references used by the Flutter planner
    match /renovation_templates/{templateId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Builders / mobile app users ─────────────────────────────────────────
    // Profiles + fcmTokens live on users/{uid}. Nested drafts stay owner-only.
    // Owner must be able to list their own user doc + subcollections.
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /favorites/{favoriteId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }

      match /saved_projects/{projectId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // Same path as the nested match above. Listed twice so a collection query
    // on saved_projects cannot fall through a recursive default-deny.
    match /users/{userId}/saved_projects/{projectId} {
      allow read, write: if isOwner(userId);
    }

    // ── Project posts / quotations (web shops + Flutter builders) ───────────
    match /projectPosts/{postId} {
      // Posts stay private to the owning builder and approved shops that quote.
      allow get, list: if isAdmin()
        || isPostOwner(resource.data)
        || isApprovedShop();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.projectName is string
        && request.resource.data.projectName.size() > 0
        && request.resource.data.projectName.size() <= 200
        && request.resource.data.materials is list
        && request.resource.data.materials.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.quotationCount == 0
        && !request.resource.data.keys().hasAny([
             'price', 'unitPrice', 'catalogPrice', 'estimatedTotal', 'listPrice'
           ]);

      // Admin; shop bid-counter bump; or the owning builder (accept offer, edits).
      allow update: if isAdmin()
        || (isApprovedShop()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["quotationCount", "updatedAt"]))
        || (isPostOwner(resource.data)
            && request.resource.data.get('userId', null) == resource.data.get('userId', null));

      allow delete: if isAdmin() || isPostOwner(resource.data);

      match /quotations/{quotationId} {
        allow get, list: if isAdmin()
          || (signedIn() && (
            ownsPostedEstimate(postId)
            || resource.data.shopId == request.auth.uid
            || request.auth.uid == quotationId
          ));

        allow create: if isAdmin();

        allow update: if isAdmin()
          || (ownsPostedEstimate(postId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'acceptedAt', 'items', 'acceptedTotal'])
              && request.resource.data.status in ['accepted', 'rejected', 'partially_accepted']
              && request.resource.data.shopId == resource.data.shopId
              && request.resource.data.projectId == resource.data.projectId);

        allow delete: if isAdmin()
          || (signedIn()
              && resource.data.shopId == request.auth.uid
              && shopIsApproved(request.auth.uid)
              && resource.data.status == 'pending');
      }

      match /acceptance/{acceptanceId} {
        allow read: if isAdmin()
          || (signedIn() && ownsPostedEstimate(postId))
          || (signedIn() && resource.data.shopId == request.auth.uid);
        allow create: if signedIn()
          && ownsPostedEstimate(postId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Collection-group queries used by the web shop dashboard.
    // Builders only see quotes on their own posts; shops only see their own.
    match /{path=**}/quotations/{quotationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.shopId == request.auth.uid)
        || (signedIn() && (
             resource.data.userId == request.auth.uid
             || resource.data.builderId == request.auth.uid
           ));

      // Same lockdown as the nested rule above — this collection-group match
      // overlaps the same documents, and Firestore grants access if EITHER
      // matching rule allows it. Leaving this one permissive would have
      // completely undone locking down the nested create rule.
      allow create: if isAdmin();
    }

    // Builder ↔ shop chat. Unlocks after a quotation is accepted.
    // Canonical builder uid is userId on the post; conversations store it as
    // builderId (and may also copy userId).
    match /conversations/{conversationId} {
      function isConvParticipant(data) {
        return signedIn() && (
          data.builderId == request.auth.uid
          || data.userId == request.auth.uid
          || data.shopId == request.auth.uid
        );
      }

      function acceptedQuoteForConv() {
        return request.resource.data.projectId is string
          && request.resource.data.quotationId is string
          && exists(/databases/$(database)/documents/projectPosts/$(request.resource.data.projectId)/quotations/$(request.resource.data.quotationId))
          && get(/databases/$(database)/documents/projectPosts/$(request.resource.data.projectId)/quotations/$(request.resource.data.quotationId)).data.status in ['accepted', 'partially_accepted']
          && (
               get(/databases/$(database)/documents/projectPosts/$(request.resource.data.projectId)/quotations/$(request.resource.data.quotationId)).data.shopId == request.resource.data.shopId
               || request.resource.data.quotationId == request.resource.data.shopId
             );
      }

      allow get: if isAdmin()
        || (signedIn() && (
             !exists(/databases/$(database)/documents/conversations/$(conversationId))
             || isConvParticipant(resource.data)
           ));
      allow list: if isAdmin() || isConvParticipant(resource.data);

      allow create: if signedIn()
        && (request.resource.data.builderId == request.auth.uid
            || request.resource.data.userId == request.auth.uid)
        && ownsPostedEstimate(request.resource.data.projectId)
        && request.resource.data.shopId is string
        && request.resource.data.shopId.size() > 0
        && request.resource.data.projectId is string
        && request.resource.data.status == 'open'
        && acceptedQuoteForConv();

      // Participants may update the thread summary and their own read marker.
      // shopLastReadAt / builderLastReadAt back the Sent / Seen indicators.
      allow update: if isAdmin()
        || (isConvParticipant(resource.data)
            && request.resource.data.shopId == resource.data.shopId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'updatedAt', 'status',
                           'shopLastReadAt', 'builderLastReadAt']));

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin()
          || isConvParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);

        // A message carries text, an imageUrl, or both. Text (when present) is
        // a string <= 4000 chars; imageUrl (when present) is an https URL
        // <= 2000 chars. At least one of the two must be a non-empty string.
        allow create: if signedIn()
          && isConvParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole in ['builder', 'shop']
          // The official quotation invoice is posted only by the server, from
          // the real quotation. A client can't post one — otherwise a shop
          // could send a fake "official" invoice with prices it made up.
          && request.resource.data.get('type', '') != 'quotation_invoice'
          && !('quotationSnapshot' in request.resource.data)
          && (
               !('text' in request.resource.data)
               || (request.resource.data.text is string
                   && request.resource.data.text.size() <= 4000)
             )
          && (
               !('imageUrl' in request.resource.data)
               || (request.resource.data.imageUrl is string
                   && request.resource.data.imageUrl.size() <= 2000
                   && request.resource.data.imageUrl.matches('https://.*'))
             )
          && (
               request.resource.data.get('text', '').size() > 0
               || request.resource.data.get('imageUrl', '').size() > 0
             );

        allow update, delete: if false;
      }
    }

    // ── Contact Us messages (web-only: public submit → admin inbox) ────────
    // Not used by the Flutter app. Anyone may create a well-formed message;
    // only admins can read / triage / delete.
    match /contactMessages/{messageId} {
      // Public submissions go through the submitContactMessage Cloud Function
      // (cross-instance rate limits + honeypot). An unauthenticated direct
      // create could be scripted to flood the admin inbox.
      allow create: if false;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // In-app notifications — written by Cloud Functions (Admin SDK) only.
    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isRead']);
      allow create: if false;
      allow delete: if signedIn()
        && resource.data.recipientId == request.auth.uid;
    }

    // Unknown collections stay closed. Add an explicit match before shipping
    // a new one — coordinate with the web teammate first.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
