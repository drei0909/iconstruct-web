rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shopIsApproved(shopId) {
      return shopId is string
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.status is string
        && get(/databases/$(database)/documents/shops/$(shopId)).data.status.matches('(?i)^approved$');
    }

    // ── Admins ──────────────────────────────────────────────────────────────
    // Unauthenticated read allows forgot-password email lookup (same pattern
    // as approved shops being readable for shop password reset).
    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId) || !signedIn();
      allow write: if isAdmin();
    }

    // ── Shops ───────────────────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read: if isOwner(shopId) || isAdmin()
                  || (resource.data.status == "approved");
      allow create: if isOwner(shopId)
                    && request.resource.data.subscriptionPlan == "basic"
                    && request.resource.data.status == "pending";
      // Owners may edit profile fields only — not plan, approval, or billing status.
      // Cloud Functions (Admin SDK) bypass rules for PayMongo activation.
      allow update: if isAdmin() || (
        isOwner(shopId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              "subscriptionPlan",
              "subscriptionStatus",
              "subscriptionExpiry",
              "status",
            ])
      )
      || (
        isOwner(shopId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.status == "deleted"
      );
      allow delete: if isAdmin();

      // Product categories under a shop (used by ProductsTab)
      match /categories/{categoryId} {
        allow read: if isOwner(shopId) || isAdmin()
                    || get(/databases/$(database)/documents/shops/$(shopId)).data.status == "approved";
        allow write: if (isOwner(shopId) && shopIsApproved(shopId)) || isAdmin();
      }
    }

    // ── OTPs (email verification)
    // Codes are written/read only by Cloud Functions (Admin SDK).
    match /otps/{email} {
      allow read, write: if false;
    }

    // PayMongo audit (Admin SDK only)
    match /paymongoActivations/{sessionId} {
      allow read, write: if false;
    }
    match /paymongoEvents/{eventId} {
      allow read, write: if false;
    }
    match /checkoutSessions/{sessionId} {
      allow read, write: if false;
    }

    // ── Subscription payments ───────────────────────────────────────────────
    match /subscriptionPayments/{paymentId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.shopId == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.shopId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── System config (plans, maintenance, etc.) ────────────────────────────
    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /systemLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Products ────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
      allow update: if signedIn()
        && resource.data.shopId == request.auth.uid
        && request.resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
      allow delete: if signedIn()
        && resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
    }

    // ── Builders / mobile app users (Flutter — do not lock this out) ────────
    // App stores builder profiles + fcmTokens under users/{uid}.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    function isPostOwner(postId) {
      return signedIn()
        && exists(/databases/$(database)/documents/projectPosts/$(postId))
        && (
          get(/databases/$(database)/documents/projectPosts/$(postId)).data.userId == request.auth.uid
          || get(/databases/$(database)/documents/projectPosts/$(postId)).data.builderId == request.auth.uid
          || get(/databases/$(database)/documents/projectPosts/$(postId)).data.ownerId == request.auth.uid
          || get(/databases/$(database)/documents/projectPosts/$(postId)).data.postedBy == request.auth.uid
        );
    }

    // ── Project posts / quotations (shared: web shops + Flutter builders) ───
    // Keep these permissive for the collab app. Tighten only with teammate agreement.
    match /projectPosts/{postId} {
      allow read: if signedIn();
      // Builders (app) create/edit posts; shops may only bump bid counters.
      allow create: if signedIn();
      allow update: if signedIn() && (
        isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["quotationCount", "updatedAt"])
        || resource.data.userId == request.auth.uid
        || resource.data.builderId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
        || resource.data.postedBy == request.auth.uid
      );
      allow delete: if isAdmin()
        || (signedIn() && (
          resource.data.userId == request.auth.uid
          || resource.data.builderId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
          || resource.data.postedBy == request.auth.uid
        ));

      match /quotations/{quotationId} {
        allow read: if signedIn();
        // Shops quote as themselves when approved; must set shopId = their uid.
        allow create: if signedIn()
          && request.resource.data.keys().hasAll(["shopId"])
          && request.resource.data.shopId == request.auth.uid
          && shopIsApproved(request.auth.uid);
        // Shop may edit own quote; builder (post owner) may accept/reject only.
        allow update: if isAdmin()
          || (signedIn()
              && resource.data.shopId == request.auth.uid
              && shopIsApproved(request.auth.uid))
          || (
            isPostOwner(postId)
            && resource.data.status == "pending"
            && request.resource.data.status in ["accepted", "rejected"]
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "updatedAt", "acceptedAt", "rejectedAt", "acceptedBy"])
          );
        allow delete: if isAdmin()
          || (signedIn()
              && resource.data.shopId == request.auth.uid
              && shopIsApproved(request.auth.uid));
      }
    }

    // Collection-group queries used by the web shop dashboard
    match /{path=**}/quotations/{quotationId} {
      allow read: if signedIn();
      // Mirror create so nested path + collection-group match stay consistent
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(["shopId"])
        && request.resource.data.shopId == request.auth.uid
        && shopIsApproved(request.auth.uid);
      // Collection-group match does not receive postId — accept via nested path only.
    }

    // ── Shop ↔ builder chat (unlocked after quote accept) ───────────────────
    // Shared by web shops + Flutter builders. Prefer additive allows.
    // List queries must constrain to a field the rule can prove (shopId / builderId / member_ids).
    match /conversations/{conversationId} {
      function isShopOnConv() {
        return signedIn() && resource.data.shopId == request.auth.uid;
      }
      function isBuilderOnConv() {
        return signedIn() && resource.data.builderId == request.auth.uid;
      }
      // Flutter-friendly alternate shape (array of participant uids)
      function isMemberOnConv() {
        return signedIn() && (
          (resource.data.keys().hasAny(["member_ids"])
            && request.auth.uid in resource.data.member_ids)
          || (resource.data.keys().hasAny(["memberIds"])
            && request.auth.uid in resource.data.memberIds)
        );
      }

      // Separate allow lines so shopId / builderId list queries validate cleanly.
      allow read: if isShopOnConv();
      allow read: if isBuilderOnConv();
      allow read: if isMemberOnConv();
      allow read: if isAdmin();

      // Shop or builder may open thread once quote is accepted (client fallback).
      // Cloud Functions (Admin SDK) also create threads.
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(["shopId", "builderId", "projectId", "status"])
        && request.resource.data.status == "open"
        && (
          request.resource.data.shopId == request.auth.uid
          || request.resource.data.builderId == request.auth.uid
        );
      // Flutter may create with member_ids instead of (or in addition to) shopId/builderId
      allow create: if signedIn()
        && request.resource.data.keys().hasAny(["member_ids", "memberIds"])
        && (
          (request.resource.data.keys().hasAny(["member_ids"])
            && request.auth.uid in request.resource.data.member_ids)
          || (request.resource.data.keys().hasAny(["memberIds"])
            && request.auth.uid in request.resource.data.memberIds)
        );

      allow update: if isShopOnConv() || isBuilderOnConv() || isMemberOnConv() || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentConv() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function canAccessParent() {
          return signedIn() && (
            parentConv().shopId == request.auth.uid
            || parentConv().builderId == request.auth.uid
            || (parentConv().keys().hasAny(["member_ids"])
                && request.auth.uid in parentConv().member_ids)
            || (parentConv().keys().hasAny(["memberIds"])
                && request.auth.uid in parentConv().memberIds)
            || isAdmin()
          );
        }

        allow read: if canAccessParent();
        allow create: if signedIn()
          && request.resource.data.keys().hasAll(["senderId", "senderRole", "text", "createdAt"])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole in ["shop", "builder"]
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && canAccessParent();
        allow update, delete: if false;
      }
    }

    // ── Contact Us messages (public submit → Super Admin inbox) ─────────────
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
          "name", "email", "subject", "message", "status", "createdAt"
        ])
        && request.resource.data.status == "new"
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Default deny for unknown collections only.
    // If the Flutter app adds a new collection, add an explicit rule above
    // or it will be blocked — coordinate with the mobile teammate first.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
