rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Shop registration documents (RegisterForm → authController)
    // Download URLs with tokens still work for admin review links in Firestore.
    match /shop-documents/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024;
    }

    // Product images
    match /products/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Existing profile images folder — write only under own uid prefix
    match /user_profile_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy flat paths: authenticated write only to own filename prefix (best-effort)
    match /user_profile_images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && fileName.matches(request.auth.uid + '.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
